  "[systemverilog]": {
    "editor.defaultFormatter": "bmpenuelas.systemverilog-formatter-vscode",
    "editor.formatOnSave": true    
  },

  "systemverilogFormatter.commandLineArguments": "--indentation_spaces 2 --column_limit 100 --assignment_statement_alignment infer --case_items_alignment infer --formal_parameters_alignment infer --named_parameter_alignment flush-left --port_declarations_alignment infer",

  //---------------------------------------------------------------------------
  // Others
  //---------------------------------------------------------------------------
  "better-comments.highlightPlainText": true,
  "cmake.sourceDirectory": "/workspaces/tangnano9k/sw",
  "cmake.ignoreCMakeListsMissing": true,  
}
